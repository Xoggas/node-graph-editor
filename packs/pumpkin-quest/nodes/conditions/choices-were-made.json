{
  "id": "condition.choices-were-made",
  "title": {
    "en": "Choices Were Made",
    "ru": "Выборы сделаны"
  },
  "description": {
    "en": "True if every choice of the list is in the wanted state: with Was made checked — made, without — not made.\n\nNot part of the dialogue flow: only computes a value for If and logic nodes.",
    "ru": "Истинно, если каждый выбор из списка в нужном состоянии: с отметкой «Сделан» — сделан, без неё — не сделан.\n\nНе часть потока диалога: только вычисляет значение для «Если» и логических нод."
  },
  "menu": "Conditions",
  "order": 2,
  "color": "#c46f9f",
  "ports": [
    {
      "id": "result",
      "direction": "output",
      "type": "bool",
      "label": {
        "en": "Result",
        "ru": "Результат"
      }
    }
  ],
  "fields": [
    {
      "id": "choices",
      "type": "list",
      "label": {
        "en": "Choices",
        "ru": "Выборы"
      },
      "maxItems": 15,
      "item": {
        "type": "record",
        "fields": [
          {
            "id": "choice",
            "type": "nodeRef",
            "schema": "dialogue.choice",
            "label": {
              "en": "Choice",
              "ru": "Выбор"
            },
            "required": true
          },
          {
            "id": "made",
            "type": "bool",
            "default": true,
            "label": {
              "en": "Was made",
              "ru": "Сделан"
            }
          }
        ]
      },
      "required": true
    }
  ]
}
