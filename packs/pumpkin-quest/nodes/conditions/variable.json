{
  "id": "condition.variable",
  "title": {
    "en": "Variable Comparer",
    "ru": "Сравнение переменной"
  },
  "description": {
    "en": "Compares the variable Name with the Target value using the chosen operator.\n\nNot part of the dialogue flow: only computes a value for If and logic nodes.",
    "ru": "Сравнивает переменную «Переменная» со «Значением» выбранным оператором.\n\nНе часть потока диалога: только вычисляет значение для «Если» и логических нод."
  },
  "menu": "Conditions",
  "order": 3,
  "color": "#c46f9f",
  "naming": {
    "editable": false
  },
  "ports": [
    {
      "id": "result",
      "direction": "output",
      "type": "bool",
      "label": {
        "en": "Result",
        "ru": "Результат"
      }
    }
  ],
  "fields": [
    {
      "id": "variable",
      "type": "string",
      "label": {
        "en": "Name",
        "ru": "Переменная"
      },
      "required": true,
      "symbol": {
        "kind": "variable",
        "use": "read"
      }
    },
    {
      "id": "comparison",
      "type": "enum",
      "display": "segmented",
      "label": {
        "en": "Comparison",
        "ru": "Сравнение"
      },
      "options": [
        {
          "value": "Equal",
          "label": "="
        },
        {
          "value": "NotEqual",
          "label": "≠"
        },
        {
          "value": "Greater",
          "label": ">"
        },
        {
          "value": "GreaterOrEqual",
          "label": "≥"
        },
        {
          "value": "Less",
          "label": "<"
        },
        {
          "value": "LessOrEqual",
          "label": "≤"
        }
      ]
    },
    {
      "id": "targetValue",
      "type": "int",
      "label": {
        "en": "Target value",
        "ru": "Значение"
      }
    }
  ]
}
