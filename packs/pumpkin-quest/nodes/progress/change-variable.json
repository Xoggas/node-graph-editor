{
  "id": "dialogue.change-variable",
  "title": {
    "en": "Change Variable",
    "ru": "Изменить переменную"
  },
  "description": {
    "en": "Adds Value to add to the variable Name (a negative value decreases it). The value is checked with Variable Comparer.\n\nNon-blocking: runs at once, the dialogue goes on.",
    "ru": "Прибавляет «Прибавить» к переменной «Переменная» (отрицательное значение уменьшает). Значение проверяется нодой «Сравнение переменной».\n\nНеблокирующая: выполняется сразу, диалог идёт дальше."
  },
  "menu": "Progress",
  "order": 1,
  "color": "#a3b54a",
  "blocking": false,
  "ports": [
    {
      "id": "in",
      "direction": "input",
      "type": "flow",
      "label": {
        "en": "Input",
        "ru": "Вход"
      }
    },
    {
      "id": "out",
      "direction": "output",
      "type": "flow",
      "label": {
        "en": "Output",
        "ru": "Выход"
      }
    }
  ],
  "fields": [
    {
      "id": "variable",
      "type": "string",
      "label": {
        "en": "Name",
        "ru": "Переменная"
      },
      "required": true,
      "symbol": {
        "kind": "variable",
        "use": "write"
      }
    },
    {
      "id": "valueToAdd",
      "type": "int",
      "label": {
        "en": "Value to add",
        "ru": "Прибавить"
      }
    }
  ]
}
