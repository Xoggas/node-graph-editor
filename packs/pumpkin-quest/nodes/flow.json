[
  {
    "id": "dialogue.start",
    "title": "Start",
    "description": "Точка входа: с неё начинается выполнение диалога. В графе может быть только одна.\n\nНеблокирующая: выполняется сразу, диалог идёт дальше.",
    "menu": "Flow",
    "color": "#4fb37a",
    "singleton": true,
    "naming": {
      "editable": false
    },
    "meta": {
      "nodeType": "NonBlocking"
    },
    "ports": [
      {
        "id": "out",
        "direction": "output",
        "type": "flow",
        "label": "Output"
      }
    ]
  },
  {
    "id": "dialogue.if",
    "title": "If",
    "description": "Ветвление: проверяет условие на входе Condition и продолжает по выходу True или False. Условия собираются из нод Conditions и Logic.\n\nНеблокирующая: выполняется сразу, диалог идёт дальше.",
    "menu": "Flow",
    "color": "#4fb37a",
    "meta": {
      "nodeType": "NonBlocking"
    },
    "ports": [
      {
        "id": "in",
        "direction": "input",
        "type": "flow",
        "label": "Input"
      },
      {
        "id": "condition",
        "direction": "input",
        "type": "bool",
        "label": "Condition"
      },
      {
        "id": "true",
        "direction": "output",
        "type": "flow",
        "label": "True"
      },
      {
        "id": "false",
        "direction": "output",
        "type": "flow",
        "label": "False"
      }
    ]
  },
  {
    "id": "dialogue.choice-matrix",
    "title": "Choice Matrix",
    "description": "Выбирает исход по комбинации сделанных ранее выборов. Столбцы (C1, C2…) — выборы из списка Conditions, строки (O1, O2…) — исходы; клетки задают, какие выборы нужны для исхода. Подошедший исход идёт в свой выход Output N, иначе — в Default.\n\nНеблокирующая: выполняется сразу, диалог идёт дальше.",
    "menu": "Flow",
    "color": "#4fb37a",
    "meta": {
      "nodeType": "NonBlocking"
    },
    "ports": [
      {
        "id": "in",
        "direction": "input",
        "type": "flow",
        "label": "Input"
      },
      {
        "id": "outcome",
        "direction": "output",
        "type": "flow",
        "repeat": {
          "count": "outcomes",
          "label": "Output {i}"
        }
      },
      {
        "id": "default",
        "direction": "output",
        "type": "flow",
        "label": "Default"
      }
    ],
    "fields": [
      {
        "id": "choices",
        "type": "list",
        "label": "Conditions",
        "maxItems": 30,
        "item": {
          "type": "record",
          "fields": [
            {
              "id": "choice",
              "type": "nodeRef",
              "schema": "dialogue.choice",
              "label": "Choice"
            }
          ]
        }
      },
      {
        "id": "outcomes",
        "type": "int",
        "label": "Outcomes",
        "min": 0,
        "max": 30
      },
      {
        "id": "states",
        "type": "matrix",
        "cell": "bool",
        "rows": "outcomes",
        "columns": "choices",
        "rowLabel": "O{i}",
        "columnLabel": "C{i}",
        "label": "Matrix"
      }
    ]
  },
  {
    "id": "dialogue.end",
    "title": "End",
    "description": "Завершает диалог. Ending задаёт, что будет дальше: выход в главное меню или перезапуск.\n\nНеблокирующая: выполняется сразу, диалог идёт дальше.",
    "menu": "Flow",
    "color": "#4fb37a",
    "naming": {
      "editable": false
    },
    "meta": {
      "nodeType": "NonBlocking"
    },
    "ports": [
      {
        "id": "in",
        "direction": "input",
        "type": "flow",
        "label": "Input"
      }
    ],
    "fields": [
      {
        "id": "endingType",
        "type": "enum",
        "label": "Ending",
        "options": [
          {
            "value": "GoToMainMenu",
            "label": "Go to main menu"
          },
          {
            "value": "Restart",
            "label": "Restart"
          }
        ]
      }
    ]
  },
  {
    "id": "dialogue.line",
    "title": "Line",
    "description": "Реплика: персонаж Character с эмоцией Emotion произносит текст Line. Имя ноды — ключ локализации текста. Варианты ответа — ноды Choice, подключённые к Next.\n\nБлокирующая: диалог ждёт, пока игрок не продолжит.",
    "menu": "Dialogue",
    "color": "#5b8fd9",
    "naming": {
      "unique": true,
      "pattern": "^[\\p{L}0-9 ,.']+$",
      "auto": "chapter.index"
    },
    "meta": {
      "nodeType": "Blocking"
    },
    "ports": [
      {
        "id": "in",
        "direction": "input",
        "type": "flow",
        "label": "Input"
      },
      {
        "id": "next",
        "direction": "output",
        "type": "flow",
        "capacity": "multiple",
        "label": "Next"
      }
    ],
    "fields": [
      {
        "id": "speaker",
        "type": "resource",
        "resourceType": "character",
        "label": "Character",
        "previewHeight": 200
      },
      {
        "id": "emotion",
        "type": "resourceVariant",
        "source": "speaker",
        "collection": "emotions",
        "label": "Emotion"
      },
      {
        "id": "line",
        "type": "localizedText",
        "keyFrom": "name",
        "multiline": true,
        "label": "Line"
      }
    ]
  },
  {
    "id": "dialogue.choice",
    "title": "Choice",
    "description": "Вариант ответа игрока: кнопка с текстом Text. Выход ведёт в ветку, которая выполнится, если игрок выберет этот вариант. Сделанный выбор проверяется нодами Choice Was Made и Choices Were Made. Имя ноды — ключ локализации текста.\n\nНеблокирующая: выполняется сразу, диалог идёт дальше.",
    "menu": "Dialogue",
    "color": "#5b8fd9",
    "naming": {
      "unique": true,
