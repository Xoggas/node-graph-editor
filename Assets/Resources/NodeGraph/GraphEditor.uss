.node-graph-editor {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(24, 25, 29);
}

.graph-toolbar {
    height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(37, 39, 44);
    border-bottom-width: 1px;
    border-bottom-color: rgb(75, 78, 86);
}

.graph-toolbar Button,
.node-palette Button {
    min-height: 26px;
    margin-right: 5px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: rgb(229, 231, 235);
    background-color: rgb(65, 68, 75);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(101, 105, 114);
    border-right-color: rgb(101, 105, 114);
    border-bottom-color: rgb(101, 105, 114);
    border-left-color: rgb(101, 105, 114);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.graph-toolbar Button:hover,
.node-palette Button:hover {
    color: rgb(250, 250, 250);
    background-color: rgb(83, 87, 96);
    border-top-color: rgb(153, 157, 166);
    border-right-color: rgb(153, 157, 166);
    border-bottom-color: rgb(153, 157, 166);
    border-left-color: rgb(153, 157, 166);
}

.graph-toolbar Button:active,
.node-palette Button:active {
    background-color: rgb(48, 50, 55);
}

.graph-workspace {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.node-palette {
    flex-direction: column;
    padding: 8px;
}

.node-palette-panel {
    width: 228px;
    flex-shrink: 0;
    background-color: rgb(34, 36, 41);
    border-left-width: 1px;
    border-left-color: rgb(75, 78, 86);
    padding-top: 10px;
    padding-bottom: 8px;
}

.node-palette-title {
    flex-shrink: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 8px;
    color: rgb(236, 238, 242);
    font-size: 14px;
    -unity-font-style: bold;
}

.node-palette-scroll {
    flex-grow: 1;
    min-height: 0;
}

.node-palette-item {
    flex-shrink: 0;
    min-height: 42px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgb(57, 60, 67);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(91, 95, 104);
    border-right-color: rgb(91, 95, 104);
    border-bottom-color: rgb(91, 95, 104);
    border-left-color: rgb(91, 95, 104);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.node-palette-item:hover,
.node-palette-item.dragging {
    background-color: rgb(74, 78, 87);
    border-top-color: rgb(150, 155, 166);
    border-right-color: rgb(150, 155, 166);
    border-bottom-color: rgb(150, 155, 166);
    border-left-color: rgb(150, 155, 166);
}

.node-palette-item-title {
    color: rgb(239, 241, 245);
    font-size: 13px;
    -unity-font-style: bold;
}

.node-palette-item-type {
    margin-top: 2px;
    color: rgb(176, 181, 191);
    font-size: 10px;
}

.node-palette-drag-ghost {
    display: none;
    position: absolute;
    min-width: 170px;
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    color: rgb(245, 246, 248);
    background-color: rgba(74, 78, 87, 0.94);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(185, 190, 200);
    border-right-color: rgb(185, 190, 200);
    border-bottom-color: rgb(185, 190, 200);
    border-left-color: rgb(185, 190, 200);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-left;
}

.status-label {
    min-width: 180px;
    flex-shrink: 1;
    color: rgb(184, 188, 196);
    -unity-text-align: middle-right;
}

.graph-canvas-host {
    flex-grow: 1;
    min-width: 0;
    background-color: rgb(24, 25, 29);
}
