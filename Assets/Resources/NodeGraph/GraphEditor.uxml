<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="editor-root" class="node-graph-editor">
        <ui:VisualElement name="toolbar" class="graph-toolbar">
            <ui:Button name="new-button" text="New" />
            <ui:Button name="open-button" text="Open" />
            <ui:Button name="save-button" text="Save" />
            <ui:Label name="status-label" class="status-label" />
        </ui:VisualElement>
        <ui:VisualElement name="graph-workspace" class="graph-workspace">
            <ui:VisualElement name="canvas-host" class="graph-canvas-host" />
            <ui:VisualElement name="node-palette-panel" class="node-palette-panel">
                <ui:Label name="node-palette-title" class="node-palette-title" text="Nodes" />
                <ui:ScrollView name="node-palette-scroll" class="node-palette-scroll">
                    <ui:VisualElement name="node-palette" class="node-palette" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="node-palette-drag-ghost" class="node-palette-drag-ghost" />
    </ui:VisualElement>
</ui:UXML>
